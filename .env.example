ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GA4_PROPERTY_ID=123456789
AUTH_PASSWORD_HASH=# scrypt:... from: node scripts/hash-password.mjs (see README)
JWT_SECRET=# min 32 chars, generate with: openssl rand -hex 32
# optional — omit for local SQLite file
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=...
# optional — what the assistant should know about your org, appended to its instructions
# ORG_CONTEXT=We are a regional food bank. Donations are tracked as the `donate` event.
# optional — name shown in the app; defaults to GA4 Chat (max 60 chars)
# APP_NAME=Food Bank Analytics
